  "components": {
    "schemas": {
      "AnalyticFocus": {
        "type": "string",
        "enum": [
          "CFO",
          "CEO"
        ],
        "title": "AnalyticFocus"
      },
      "ArticleEvidenceIn": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "title": "Evidence Id"
          },
          "quote": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Quote"
          },
          "supports": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Supports"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "quote",
          "supports"
        ],
        "title": "ArticleEvidenceIn"
      },
      "BankFragmentIn": {
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Number"
          },
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "ocr_quality": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ocr Quality"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "page_number",
          "text",
          "ocr_quality"
        ],
        "title": "BankFragmentIn"
      },
      "BankReportIn": {
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "report_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Date"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash"
          },
          "original_filename": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Original Filename"
          },
          "fragments": {
            "items": {
              "$ref": "#/components/schemas/BankFragmentIn"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Fragments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "title",
          "content_hash",
          "original_filename",
          "fragments"
        ],
        "title": "BankReportIn"
      },
      "FeedbackRequest": {
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "useful",
              "not_useful"
            ],
            "title": "Rating"
          },
          "reason": {
            "type": "string",
            "enum": [
              "relevant",
              "irrelevant",
              "factual_error",
              "outdated",
              "unclear",
              "other"
            ],
            "title": "Reason"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rating",
          "reason"
        ],
        "title": "FeedbackRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InsightCreateRequest": {
