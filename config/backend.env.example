# Compose reads .env in the project root. Copy this file to .env if needed.
# The Python CLI reads process environment variables, not dotenv files.
ALFA_ENV=development
ALFA_PORT=8080
ALFA_DEMO_SEED=1
ALFA_DEMO_TOKENS=TEST_A=demo-test-a,TEST_B=demo-test-b
ALFA_ADMIN_TOKEN=demo-admin
ALFA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALFA_ALLOWED_SOURCE_HOSTS=www.cbr.ru,cbr.ru,www.interfax.ru,interfax.ru
ALFA_LLM_ENABLED=0
# Set a stable random value of at least 24 UTF-8 bytes before issuing real sessions.
# ALFA_AUTH_TOKEN_PEPPER=
# Enable only with the organizer-approved model, API credentials and cost bound.
# ALFA_LLM_BASE_URL=https://YOUR_PROVIDER/v1
# ALFA_LLM_API_KEY=
# ALFA_LLM_MODEL=
# ALFA_LLM_MAX_CALL_KOPECKS=
