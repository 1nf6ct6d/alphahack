              "tax_change",
              "input_cost_change",
              "demand_change",
              "monetary_policy_change",
              "counterparty_disruption",
              "other"
            ],
            "title": "Event Type"
          },
          "content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500000
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "factor_classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Factor Classes"
          },
          "okved_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Okved Codes"
          },
          "geography": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Geography"
          },
          "entities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Entities"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/ArticleEvidenceIn"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Evidence"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "mandatory": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mandatory"
          },
          "applies_to_all_in_scope": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applies To All In Scope"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          },
          "extraction_status": {
            "type": "string",
            "enum": [
              "full_text",
              "metadata_only",
              "error"
            ],
            "title": "Extraction Status",
            "default": "full_text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "title",
          "source_id",
          "source_url",
          "event_type"
        ],
        "title": "NormalizedEventIn"
      },
